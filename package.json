{
  "name": "workstar",
  "workspaces": [
    "packages/*",
    "templates/worker"
  ],
  "version": "0.1.0-alpha.5",
  "description": "An experimental, small reactive UI framework for the web.",
  "type": "module",
  "license": "MIT",
  "author": "Workstar Lab <hello@workstarlab.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wslab-ai/workstar.git"
  },
  "homepage": "https://github.com/wslab-ai/workstar#readme",
  "bugs": {
    "url": "https://github.com/wslab-ai/workstar/issues"
  },
  "keywords": [
    "framework",
    "reactivity",
    "signals",
    "dom",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "templates/basic",
    "templates/worker/gitignore.txt",
    "templates/worker/package.json",
    "templates/worker/public/style.css",
    "templates/worker/README.md",
    "templates/worker/src/index.ts",
    "templates/worker/tsconfig.json",
    "templates/worker/wrangler.jsonc",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "workstar": "bin/workstar.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "dev": "vite examples",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "check": "tsc --noEmit",
    "test": "vitest run --exclude 'packages/**'",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "size": "node scripts/check-size.js",
    "verify:starter": "node scripts/verify-starter.js",
    "verify:hydration": "npm run build && node scripts/verify-hydration.js",
    "verify:router": "npm run check --workspace workstar-router && npm run test --workspace workstar-router && npm run build --workspace workstar-router",
    "verify:app": "npm run check --workspace workstar-app && npm run test --workspace workstar-app && npm run build --workspace workstar-app",
    "verify:worker": "npm run check --workspace workstar-worker-starter && node scripts/verify-worker.js",
    "verify": "npm run format:check && npm run check && npm test && npm run build && npm run size && npm run verify:router && npm run verify:app && npm run verify:worker && npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "happy-dom": "^20.8.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
