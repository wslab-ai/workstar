{
  "name": "workstar-language",
  "displayName": "Workstar Language Support",
  "description": "Syntax highlighting, project compiler diagnostics, and editing support for .workstar components.",
  "version": "0.1.2",
  "private": true,
  "publisher": "wslab-ai",
  "main": "./out/extension.js",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wslab-ai/workstar.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting remains available; diagnostics run only after the workspace is trusted."
    }
  },
  "activationEvents": [
    "onLanguage:workstar"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "workstar",
    "components",
    "typescript",
    "html"
  ],
  "contributes": {
    "languages": [
      {
        "id": "workstar",
        "aliases": [
          "Workstar",
          "workstar"
        ],
        "extensions": [
          ".workstar"
        ],
        "icon": {
          "light": "./images/icon.png",
          "dark": "./images/icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "workstar",
        "scopeName": "text.html.workstar",
        "path": "./syntaxes/workstar.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.css": "css"
        }
      }
    ],
    "snippets": [
      {
        "language": "workstar",
        "path": "./snippets/workstar.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "package": "npm run build && node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && vsce package --no-dependencies --out dist/workstar-language-0.1.2.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^6.0.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
